<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloneLiteApp.ViewModels"
             x:Class="CloneLiteApp.Views.CadastraProdutoView"
             x:DataType="vm:CadastraProdutoViewModel">

    <StackPanel Margin="15" Spacing="8" MaxWidth="450" HorizontalAlignment="Left">

        <TextBlock Text="Cadastrar produto"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,10" />

        <TextBlock Text="Descrição:" />
        <TextBox Text="{Binding Descricao}" />

        <TextBlock Text="Unidade de medida:" />
        <ComboBox ItemsSource="{Binding unidade}"
                  SelectedItem="{Binding UnidadeSelecionada}" />

        <TextBlock Text="Código de barras (EAN-13):" />
        <TextBox Text="{Binding CodigoBarras}" />

        <TextBlock Text="Referência:" />
        <TextBox Text="{Binding Referencia}" />

        <TextBlock Text="Quantidade:" />
        <NumericUpDown Value="{Binding Quantidade}" FormatString="0.000" />

        <TextBlock Text="Preço de venda:" />
        <NumericUpDown Value="{Binding PrecoVenda}" FormatString="0.00" />

        <TextBlock Text="Custo de compra:" />
        <NumericUpDown Value="{Binding PrecoCompra}" FormatString="0.00" />

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Content="Salvar" Command="{Binding SalvarCommand}" />
            <Button Content="Limpar" Command="{Binding LimpaCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Mensagem}" Foreground="DarkGreen" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>