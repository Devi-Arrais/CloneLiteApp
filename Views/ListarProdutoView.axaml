<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloneLiteApp.ViewModels"
             xmlns:models="using:CloneLiteApp.Models"
             x:Class="CloneLiteApp.Views.ListarProdutosView"
             x:DataType="vm:ListarProdutosViewModel">

    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal" Spacing="10"
                    Margin="0,0,0,10">
            <TextBlock Text="Produtos cadastrados"
                       FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <ListBox Name="ListaProdutosBox"
                 ItemsSource="{Binding ListaProdutos}"
                 SelectedItem="{Binding ProdutoSelecionado}"
                 DoubleTapped="OnItemDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Produtos">
                    <Grid ColumnDefinitions="60,*,120,120" Margin="4">
                        <TextBlock Grid.Column="0" Text="{Binding id}" />
                        <TextBlock Grid.Column="1" Text="{Binding descricao}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding unidade_medida}" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding preco_venda, StringFormat='R$ {0:N2}'}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>