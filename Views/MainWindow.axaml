<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CloneLiteApp.ViewModels"
        x:Class="CloneLiteApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CloneLite"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen">


    <Window.Styles>
        <!-- Estado de hover: mantém exatamente o mesmo fundo -->
        <Style Selector="Button.SemEfeitoHover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
    </Window.Styles>
    <Grid ColumnDefinitions="180,*">

        <Border Grid.Column="0" Background="#2E3440" Padding="10">
            <StackPanel Spacing="5">
                <TextBlock Text="CloneLite"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,15" />

                <Button Content="Produtos"
                        Classes="SemEfeitoHover"
                        Command="{Binding AbrirProdutosCommand}"
                        HorizontalAlignment="Stretch" Foreground="White" />
                
                <Button Content="Clientes"
                        Classes="SemEfeitoHover"
                        Command="{Binding ClienteCommand}"
                        HorizontalAlignment="Stretch" Foreground="White" />


            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentCategoria}" />
    </Grid>
</Window>