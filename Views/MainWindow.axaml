<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CloneLiteApp.ViewModels"
        x:Class="CloneLiteApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CloneLite"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="200,*">

        <!-- Menu lateral -->
        <Border Grid.Column="0" Background="#2E3440"  Padding="10">
            <StackPanel Spacing="5">
                <TextBlock Text="CloneLite"
                        Foreground="White" FontSize="18" FontWeight="Bold"
                        Margin="0,0,0,15" />

                <Button Content="Produtos"
                        Command="{Binding MostrarListaCommand}"
                        HorizontalAlignment="Stretch" />

                <Button Content="Cadastrar Produto"
                        Command="{Binding MostrarCadastroCommand}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <!-- Área de conteúdo, onde as Views são trocadas -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}" />
    </Grid>
</Window>